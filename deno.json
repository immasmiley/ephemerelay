{
  "tasks": {
    "dev": "deno run --allow-net --watch server.ts",
    "test": "deno test --allow-net",
    "start": "deno run --allow-net server.ts"
  },
  "imports": {
    "nostr-tools": "npm:nostr-tools@^1.7.4"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom"],
    "types": ["deno.ns"]
  },
  "lint": {
    "files": {
      "include": ["."]
    },
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "files": {
      "include": ["."]
    },
    "options": {
      "useTabs": false,
      "lineWidth": 120,
      "indentWidth": 2,
      "semiColons": true,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  }
}
